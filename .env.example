# Copy to .env next to compose.yaml. Never commit .env: it holds your token.

# GitHub token with Copilot access (macOS/Linux: gh auth token; Windows: gh auth token in PowerShell)
GH_TOKEN=

# Copilot model (default gpt-6-luna; docker compose run --rm console list shows the ones your plan allows)
# MINI_A_MODEL=auto
# Optional models for Mini-A's other roles
MINI_A_LC_MODEL=
MINI_A_VAL_MODEL=
MINI_A_DEC_MODEL=

# Another provider instead of Copilot: set a full model definition (see: docker compose run --rm console help)
# Use host.docker.internal, not localhost, for servers running on your laptop (e.g. Ollama).
OAF_MODEL=

# Fixed Wiki Studio access token (at least 32 characters); empty = a new one each start
STUDIO_TOKEN=

# Wiki used by console, web, web-adv, mcp and mcp-safe: a folder in $MINI_A_DATA/wikis
WIKI=main

# Folder mounted at /data (wikis in wikis/, Wiki Studio state in studio/)
MINI_A_DATA=./data
# Folder mounted at /work
MINI_A_DIR=.

# MINI_A_IMAGE=nmaguiar/mini-a-ghc
